generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                 String       @id @default(uuid())
  username           String       @unique
  passwordHash       String       @map("password_hash")
  mustChangePassword Boolean      @default(true) @map("must_change_password")
  role               String       @default("ADMIN")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  sessions           Session[]
  auditLogs          AuditLog[]

  @@map("admin_users")
}

model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique @map("session_token")
  userId       String    @map("user_id")
  expiresAt    DateTime  @map("expires_at")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Profile {
  id         String   @id @default(uuid())
  name       String   @default("Athrav Pathak")
  headline   String
  bio        String   @db.Text
  email      String
  location   String?
  status     String?  @default("Available for engineering opportunities")
  avatarUrl  String?  @map("avatar_url")
  githubUrl  String?  @map("github_url")
  linkedinUrl String? @map("linkedin_url")
  twitterUrl String?  @map("twitter_url")
  websiteUrl String?  @map("website_url")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  subtitle    String?
  summary     String   @db.Text
  description String   @db.Text
  category    String   @default("Full Stack")
  featured    Boolean  @default(false)
  techStack   String[] @map("tech_stack")
  liveUrl     String?  @map("live_url")
  repoUrl     String?  @map("repo_url")
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isPublished])
  @@index([sortOrder])
  @@index([featured])
  @@map("projects")
}

model Certification {
  id            String    @id @default(uuid())
  title         String
  issuer        String
  issueDate     DateTime? @map("issue_date")
  expiryDate    DateTime? @map("expiry_date")
  credentialId  String?   @map("credential_id")
  credentialUrl String?   @map("credential_url")
  imageUrl      String?   @map("image_url")
  sortOrder     Int       @default(0) @map("sort_order")
  isPublished   Boolean   @default(false) @map("is_published")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([sortOrder])
  @@map("certifications")
}

model Experience {
  id             String    @id @default(uuid())
  role           String
  company        String
  employmentType String?   @default("Full-time") @map("employment_type")
  workplaceType  String?   @default("On-site") @map("workplace_type")
  location       String?
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  isCurrent      Boolean   @default(false) @map("is_current")
  description    String    @db.Text
  technologies   String[]
  sortOrder      Int       @default(0) @map("sort_order")
  isPublished    Boolean   @default(false) @map("is_published")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([sortOrder])
  @@map("experiences")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  category    String   // e.g. Languages, Frameworks, Cloud, Databases, Architecture, Tools
  proficiency String?  // e.g. Advanced, Proficient, Familiar
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isPublished])
  @@index([sortOrder])
  @@map("skills")
}

model Education {
  id               String    @id @default(uuid())
  institution      String
  degree           String
  fieldOfStudy     String?   @map("field_of_study")
  university       String?
  status           String    @default("Completed")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  expectedGradYear Int?      @map("expected_grad_year")
  grade            String?
  activities       String?   @db.Text
  description      String?   @db.Text
  sortOrder        Int       @default(0) @map("sort_order")
  isPublished      Boolean   @default(false) @map("is_published")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([sortOrder])
  @@map("education")
}

model Achievement {
  id          String    @id @default(uuid())
  title       String
  issuer      String?
  date        DateTime?
  description String?   @db.Text
  badgeUrl    String?   @map("badge_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isPublished Boolean   @default(false) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([sortOrder])
  @@map("achievements")
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String
  message    String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  isArchived Boolean  @default(false) @map("is_archived")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

model AuditLog {
  id         String     @id @default(uuid())
  userId     String?    @map("user_id")
  action     String     // LOGIN_SUCCESS, LOGIN_FAILED, PASSWORD_CHANGED, PROJECT_CREATED, etc.
  entityType String?    @map("entity_type")
  entityId   String?    @map("entity_id")
  ipAddress  String?    @map("ip_address")
  userAgent  String?    @map("user_agent")
  metadata   String?    @db.Text // Safe JSON string, never secrets
  createdAt  DateTime   @default(now()) @map("created_at")
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model RateLimit {
  key       String   @id
  points    Int      @default(1)
  expireAt  DateTime @map("expire_at")

  @@index([expireAt])
  @@map("rate_limits")
}
