# Database Connection (PostgreSQL Only)
# Example local: postgresql://postgres:YOUR_PASSWORD@localhost:5432/athrav_portfolio?schema=public
# Example cloud: postgresql://username:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/athrav_portfolio?schema=public"

# Session Security Secret (Generate 32+ bytes random hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET="replace_with_a_secure_random_64_character_hex_string_in_production"

# Temporary Initial Admin Password (Used strictly by scripts/seed-admin.mjs on one-time bootstrap)
# Owner temporary credential: #Athr2007
SEED_ADMIN_PASSWORD="#Athr2007"

# Public Site URL (Used for canonical metadata and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
