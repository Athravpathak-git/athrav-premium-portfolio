# ==============================================================================
# ATHRAV PATHAK — PREMIUM 3D PORTFOLIO ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# In local development: http://localhost:3000
# In production: https://your-production-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node environment: 'development', 'test', or 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Neon PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Optional during local mock/fixture development mode.
# When omitted or empty, the app runs in safe local mock mode with full UI & admin preview.
# For production Neon PostgreSQL connection:
# Pooled connection string for application queries:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma migrations:
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographically secure random secret (min 32 characters) for signing session cookies
AUTH_SECRET="change-this-to-a-secure-random-32-character-secret-in-production"

# Session expiration duration in seconds (e.g., 604800 = 7 days)
SESSION_MAX_AGE_SECONDS=604800

# ------------------------------------------------------------------------------
# 4. INITIAL SUPER-ADMIN PROVISIONING (One-time CLI setup)
# ------------------------------------------------------------------------------
# Used only when running the CLI command: npm run seed:admin
# Set strong temporary credentials before running the command, then clear or rotate.
INITIAL_ADMIN_EMAIL=admin@athravpathak.dev
INITIAL_ADMIN_USERNAME=athrav_admin
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# ------------------------------------------------------------------------------
# 5. STORAGE PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Options: 'local' (default for dev, writes to public/uploads), 's3', 'gcs'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=public/uploads
STORAGE_MAX_FILE_SIZE_MB=10

# Optional cloud storage settings (for future integration):
# S3_BUCKET_NAME=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Options: 'mock' (default for dev, logs emails safely to console), 'resend', 'smtp'
EMAIL_PROVIDER=mock
EMAIL_FROM="Athrav Pathak Portfolio <noreply@athravpathak.dev>"
ADMIN_NOTIFICATION_EMAIL=athravpathak07@gmail.com

# Optional provider keys (for future integration):
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ------------------------------------------------------------------------------
# 7. RATE LIMITING (In-memory fallback or Redis)
# ------------------------------------------------------------------------------
# Rate limit window in seconds
RATE_LIMIT_WINDOW_SECONDS=900
# Max attempts per window for login
RATE_LIMIT_LOGIN_MAX=5
# Max attempts per window for contact form
RATE_LIMIT_CONTACT_MAX=5
